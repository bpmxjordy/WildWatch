# ──────────────────────────────────────────────
# WildSight Configuration
# Copy to .env and edit as needed
# ──────────────────────────────────────────────

# PostgreSQL
POSTGRES_DB=wildsight
POSTGRES_USER=wildsight
POSTGRES_PASSWORD=wildsight_dev
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# Flask
FLASK_ENV=development
FLASK_SECRET_KEY=change-me-in-production

# Service ports
BACKEND_PORT=5000
FRONTEND_PORT=3000

# Worker settings
FRAME_INTERVAL_SECONDS=60
MAX_CONCURRENT_EXTRACTIONS=4
BATCH_SIZE=5
FRAME_MAX_DIMENSION=1280
DETECTION_RETENTION_DAYS=30

# GPU settings
GPU_VRAM_THRESHOLD=0.95

# Notification: Email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=

# Notification: Web Push (VAPID keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIM_EMAIL=

# Model upload limits
MAX_MODEL_SIZE_MB=2048
ALLOWED_MODEL_EXTENSIONS=.pt,.onnx,.engine,.torchscript,.zip
