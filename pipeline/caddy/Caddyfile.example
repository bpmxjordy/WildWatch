# Example Caddyfile for HTTPS reverse proxy
# Place this in the caddy/ directory and run:
#   docker run -d --network pipeline_default -p 80:80 -p 443:443 \
#     -v $(pwd)/caddy/Caddyfile:/etc/caddy/Caddyfile \
#     -v caddy_data:/data caddy:2

wildsight.yourdomain.com {
    # Frontend
    handle /* {
        reverse_proxy wildsight-frontend:3000
    }

    # Backend API (direct browser access for JS fetch calls)
    handle /api/* {
        reverse_proxy wildsight-backend:5000
    }

    # Frame images
    handle /frames/* {
        reverse_proxy wildsight-backend:5000
    }
}
